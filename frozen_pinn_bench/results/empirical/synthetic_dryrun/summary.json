    "id": "pat_bench",
    "status": "Frozen-PINN predictive pointing on the bench as built (photo 2026-10-13). Analytical branch: bench model; empirical branch: measured logs (see docs/empirical_protocol.md).",
    "question": "With the same PSD information, does disturbance-context prediction beat a tuned PID when the disturbance is the Tx translation the rail can actually produce (HAPS-scaled)?",
    "receiver": {
      "mode": "direct",
      "link_distance_m": 0.3,
      "reducer_magnification": 10.0,
      "fsm_to_psd_m": 0.2,
      "fsm_to_pda_m": 0.2,
      "beam_radius_at_detectors_m": 0.00055,
      "principle": "A Tx translation D keeps the beam direction; the Rx reducer shifts the beam by D/10 at the FSM and detectors, with no angle. The PSD sees the position; the FSM re-centres it by tilting over the FSM-detector lever: theta_x = D / (2 * 10 * 0.2 m)."
    },
    "rail": {
      "axis": "x (horizontal, in the FSM plane of incidence: optical gain 2)",
      "travel_m": 0.004,
      "max_speed_m_s": 0.02,
      "max_accel_m_s2": 0.2,
      "note": "Travel = PDF FSM limit (1 mrad mechanical) mapped through the lever; beyond it the planned receiver gimbal takes over (not modelled). Speed/acceleration are assumptions until the stage is identified."
    },
    "pdf_equivalence": {
      "pdf_receiver_reducer": 0.1,
      "pdf_link_distance_m": 20000.0,
      "rail_m_per_pdf_aperture_rad": 20.0,
      "haps_lateral_m_per_rail_m": 1000.0,
      "derivation": "Equal FSM angle: PDF theta = alpha/(2*0.1); bench theta = D/(2*10*0.2 m) -> D = 20 m x alpha. A HAPS lateral displacement X at 20 km gives alpha = X/20 km -> D = X/1000. PDF Table I Tx angle std 5 urad -> 100 um. Detector-plane shift per mechanical FSM angle is 0.4 um/urad in both (lever 0.2 m = PDF lens f)."
    },
